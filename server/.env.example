# Server Port (Render provides PORT dynamically)
PORT=

# MongoDB Connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname)
MONGO_URI=

# JWT Secret Key
JWT_SECRET=

# CORS Allowed Origin (e.g. https://your-frontend.vercel.app or *)
CORS_ORIGIN=

# Relational Database / MySQL Credentials (if configured)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# API Keys (if applicable)
API_KEY=
